# ---------------------------------------------------------------------------
# BruteForceGuard environment configuration (safe example — copy to .env)
#
#   cp .env.example .env
#
# Never commit the real .env: it holds the database password.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql+psycopg://bfg_user:change-this-password@postgres:5432/bruteforceguard

# --- Application -----------------------------------------------------------
# development | test | staging | production
# In production the CORS origins and a PostgreSQL DATABASE_URL are required.
APP_ENV=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG | NOTSET
LOG_LEVEL=INFO

# --- HTTP / CORS -----------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Development default (when unset): http://localhost:5173,http://127.0.0.1:5173
# Production requires an explicit list (no '*' wildcard).
# When the dashboard is served by the reverse proxy on the same origin, the
# frontend talks to the API through /api, so no cross-origin entry is needed
# for the bundled UI itself.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Phase 7 security-intelligence tunables (optional — defaults shown)
# ---------------------------------------------------------------------------

# Comma-separated privileged accounts (risk-weighted as high-value targets)
PRIVILEGED_USERS=root,administrator,admin

# Per-service sensitivity: service:level (high|medium|low)
SERVICE_SENSITIVITY=ssh:high,rdp:high,vpn:high,web:medium,http:medium,https:medium,ftp:medium,smtp:medium,ldap:medium,imap:low,pop3:low,telnet:low,unknown:low

# Risk factor weights — must define exactly these factors and sum to 100
RISK_WEIGHTS=base_detection:40,confidence:20,behavior:15,threat_intelligence:15,target_sensitivity:10

# Start of low/medium/high/critical — 4 strictly increasing values in 0-100
RISK_LEVEL_BOUNDARIES=25,50,70,85

# Start of low/suspicious/high/hostile — 4 strictly increasing values in 0-100
REPUTATION_LEVEL_BOUNDARIES=20,40,60,80

# ---------------------------------------------------------------------------
# Legacy bootstrap (development / tests only)
# ---------------------------------------------------------------------------
# Alembic is the authoritative migration mechanism; application startup does
# NOT create tables by default.  Set to true only for legacy create_all
# workflows.  Rejected in production.
CREATE_ALL_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Role-bound API tokens (alert triage + security audit log)
# ---------------------------------------------------------------------------
# Server side: comma-separated `token=role` entries.  The role is bound to the
# token server-side and never trusted from a client header (analyst|admin):
#   ALERT_TRIAGE_API_TOKENS=analyst-token=analyst, admin-token=admin
# Unset/empty = fail closed (503) for PATCH /api/v1/alerts/{id} and
# GET /api/v1/audit/.
ALERT_TRIAGE_API_TOKENS=

# Comma-separated tokens for IP blocklist/whitelist writes; empty = disabled.
IP_MANAGEMENT_API_TOKENS=

# ---------------------------------------------------------------------------
# Frontend build (used by `npm run build` / the production image)
# ---------------------------------------------------------------------------
# Leave empty when the UI is served behind the reverse proxy (same origin,
# requests go to /api).  Set to an absolute origin when the API lives
# elsewhere, e.g. https://bfg.example.com
VITE_API_BASE_URL=

# Role-bound token the dashboard sends to alert triage writes and audit reads.
# Must match an ALERT_TRIAGE_API_TOKENS entry: the Audit log page
# (GET /api/v1/audit/) requires this token to be bound to the *admin* role
# (403 for analyst tokens, 503 when the server-side list is empty).
VITE_ALERT_TRIAGE_TOKEN=
VITE_ALERT_TRIAGE_USER=frontend

# Role-bound token for IP-management writes (VITE_IP_MANAGEMENT_USER optional).
VITE_IP_MANAGEMENT_TOKEN=